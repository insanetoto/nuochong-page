            },
            "maxItems": 64,
            "minItems": 0
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "status",
          "properties"
        ]
      },
      "maxItems": 64,
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^nc(?:\\.[a-z]+)?:[A-Za-z][A-Za-z0-9]*$"
