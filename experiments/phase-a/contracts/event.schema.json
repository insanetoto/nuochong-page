{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "runId",
    "sequence",
    "type",
    "time"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "run.created",
        "run.started",
        "run.completed",
        "run.failed",
        "run.cancelled"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "text": {
      "type": "string"
    }
  }
}
