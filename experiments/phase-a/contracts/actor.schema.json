{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "tenantId",
    "roles",
    "requestId"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "enum": [
          "member",
          "admin",
          "auditor"
        ]
      },
      "uniqueItems": true
    }
  }
}
