[Unit]
Description=Nuochong OA persistent run worker and restricted Harness
After=network-online.target
[Service]
Type=simple
WorkingDirectory=%h/.local/share/nuochong-oa-control/current
EnvironmentFile=%h/.config/nuochong-oa-control/environment
ExecStart=%h/.local/share/nuochong-oa-control/current/runtime/bin/node apps/control-api/src/worker-main.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
MemoryMax=768M
CPUQuota=100%
TasksMax=256
[Install]
WantedBy=default.target
